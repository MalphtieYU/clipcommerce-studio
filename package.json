{
  "name": "clipcommerce-studio",
  "private": false,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Local-first video commerce analytics workspace and Codex skill.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node scripts/prisma-local.mjs generate",
    "db:migrate": "node scripts/prisma-local.mjs migrate dev",
    "db:check": "node scripts/prisma-local.mjs validate",
    "db:bootstrap": "node scripts/bootstrap-db.mjs",
    "db:seed": "node prisma/seed.mjs",
    "db:setup": "npm run db:generate && npm run db:bootstrap && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "papaparse": "^5.5.4",
    "prisma": "^6.19.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
